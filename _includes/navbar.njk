<!-- Navbars -->
<header>
    <!-- Desktop navbar -->
    <nav id="navbar">
        <a class="navbar-logo" href="/">
            <figure>
                {% if page.fileSlug == "" %}
                    <img src="/assets/img/logos/smmun_dorado.webp" width="2000" height="1787" alt="Logo del SMMUN.">
                {% else %}
                    <img src="/assets/img/logos/smmun_deg.webp" width="1000" height="894" alt="Logo del SMMUN.">
                {% endif %}
            </figure>
        </a>
        <a href="/" id="index-button" class="button {{"inactive-button" if page.fileSlug != "" else "" }}">
            Inicio
        </a>
        <a href="/quienes-somos" class="button {{"inactive-button" if page.fileSlug != "quienes-somos" else "" }}">
            ¿Quiénes somos?
        </a>
        <!-- <a href="/alianzas" class="button {{"inactive-button" if page.fileSlug != "alianzas" else "" }}">
            Alianzas
        </a> -->
        <a href="/registro" class="button {{"inactive-button" if page.fileSlug != "registro" else "" }}">
            Registro
        </a>
        <a href="/recursos" class="button {{"inactive-button" if page.fileSlug != "recursos" else "" }}">
            Recursos
        </a>
    </nav>
    <!-- Mobile / small screen navbar -->
    <nav id="navbar-mobile">
        <a href="/">
            <figure class="navbar-logo">
                <!-- Load gold icon for index, deg for others -->
                {% if page.fileSlug == "" %}
                    <img src="/assets/img/logos/smmun_dorado.webp" width="2000" height="1787" alt="Logo del SMMUN.">
                {% else %}
                    <img src="/assets/img/logos/smmun_deg.webp" width="1000" height="894" alt="Logo del SMMUN.">
                {% endif %}
            </figure>
        </a>
        <ul id="nav-menu">
            <li class="nav-item">
                <a href="/">Inicio</a>
            </li>
            <li class="nav-item">
                <a href="/quienes-somos">¿Quiénes somos?</a>
            </li>
            <!-- <li class="nav-item">
                <a href="/alianzas">Alianzas</a>
            </li> -->
            <li class="nav-item">
                <a href="/registro">Registro</a>
            </li>
            <li class="nav-item">
                <a href="/recursos">Recursos</a>
            </li>
        </ul>
        <div id="hamburger">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </div>
    </nav>
</header>
