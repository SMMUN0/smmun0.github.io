<mjml>
    <mj-head>
        <mj-font
            name="Glacial Indifference"
            href="https://fonts.cdnfonts.com/css/glacial-indifference-2"
        />

        <mj-attributes>
            <mj-text
                align="center"
                color="#555"
                font-family="Glacial Indifference, Helvetica, Arial"
                font-size="14px"
            />
        </mj-attributes>
    </mj-head>

    <mj-body background-color="#eee">
        <mj-hero
            background-width="600px"
            background-url="https://smmun.com/assets/img/images/header.png"
            background-color="#8d7abb"
            padding="80px 0px"
        >
        </mj-hero>

        <mj-section background-color="#fff">
            <mj-column>
                <mj-text align="left">
                    <h1>¡Muchas gracias!</h1>
                    Hemos recibido tu inscripción. Te haremos llegar
                    próximamente tu asignación y otra información importante,
                    así que estate pendiente de tu correo.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#fff" padding="0 25px">
            <mj-column
                border-bottom="1px dashed lightgrey"
                border-top="1px dashed lightgrey"
            >
                <mj-text font-weight="bold" padding="15px 0">
                    Modalidad
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#fff" padding="0 25px">
            <mj-group>
                <mj-column
                    border-right="1px dashed lightgrey"
                    width="40%"
                    vertical-align="middle"
                >
                    <mj-text font-weight="bold" padding="15px 0">
                        Modalidad
                    </mj-text>
                </mj-column>

                <mj-column width="60%" vertical-align="middle">
                    <mj-text padding="15px 0">
                        {inscripcion.codelegacion}
                    </mj-text>
                </mj-column>
            </mj-group>
        </mj-section>

        <mj-section background-color="#fff" padding="0 25px">
            <mj-column>
                <mj-divider
                    border-width="1px"
                    border-style="dashed"
                    border-color="lightgrey"
                    padding="0"
                />
            </mj-column>
        </mj-section>

        <mj-section background-color="#fff" padding="0 25px">
            <mj-column border-bottom="1px dashed lightgrey">
                <mj-text font-weight="bold" padding="15px 0">
                    Delegación oficial
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#fff" padding="0 25px">
            <mj-group>
                <mj-column
                    border-right="1px dashed lightgrey"
                    width="40%"
                    vertical-align="middle"
                >
                    <mj-text font-weight="bold" padding="15px 0">
                        Delegación oficial
                    </mj-text>
                </mj-column>

                <mj-column width="60%" vertical-align="middle">
                    <mj-text padding="15px 0">
                        {inscripcion.delegacion_oficial}
                    </mj-text>
                </mj-column>
            </mj-group>
        </mj-section>

        <mj-section background-color="#fff" padding="0 25px">
            <mj-column>
                <mj-divider
                    border-width="1px"
                    border-style="dashed"
                    border-color="lightgrey"
                    padding="0"
                />
            </mj-column>
        </mj-section>

        <mj-section background-color="#fff" padding="0 25px">
            <mj-column border-bottom="1px dashed lightgrey">
                <mj-text font-weight="bold" padding="15px 0">
                    Datos personales
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section background-color="#fff" padding="0 25px">
            <mj-group>
                <mj-column
                    border-right="1px dashed lightgrey"
