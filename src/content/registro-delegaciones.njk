                    <option value="CSTD">Comisión de Ciencia y Tecnología para el Desarrollo (CSTD)</option>
                    <option value="CRC">United Nations Committee on the Rights of the Child (CRC) [inglés] [solo delegación individual]</option>
                    <option value="OIT">Organización Internacional del Trabajo (OIT)</option>
                    <option value="NOBEL">Comité Noruego del Nobel [solo delegación individual]</option>
                    <option value="CRM">Conferencia Regional sobre la Mujer de América Latina y el Caribe de las Naciones Unidas (CRM)</option>
                    <option value="UNFPA">Fondo de Población de las Naciones Unidas (UNFPA)</option>
                    <option value="OSGEY">United Nations Office of the Secretary-General's Envoy on Youth (OSGEY) [inglés]</option>
                    <option value="CIDH">Comisión Interamericana de Derechos Humanos (CIDH)</option>
                    <option value="CIJ">Corte Internacional de Justicia (CIJ) [solo delegación individual]</option>
                    <option value="COI">Comité Olímpico Internacional (COI)</option>
                </select>
                <div class="invalid-feedback">Debes seleccionar una opción.</div>

                <div id="comite-{{ i }}-topicos" class="comite-topico-div">
                    <h3 id="comite-{{ i }}-topico-0" class="comite-topico"></h3>
                    <h3 id="comite-{{ i }}-topico-1" class="comite-topico"></h3>
                </div>
            </div>

            {% for j in range(3) %}
