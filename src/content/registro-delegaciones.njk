<!-- Forms -->
<form method="POST" action="https://jellyfish-app-iyb7k.ondigitalocean.app/api/registro-delegaciones" name="registro-delegaciones" id="registro-delegaciones" enctype="multipart/form-data" class="col g-3" novalidate>
    <!-- Selección de modalidad -->
    <article class="titulo">
        <div class="oval">
            <h2>
                Modalidad
            </h2>
        </div>
    </article>

    <div class="mb-3">
        <div>
            <label for="modalidad" class="form-label">Selecciona tu modalidad de participación <span style="color: red;">*</span></label>
            <select autocomplete="off" data-width="86vw" class="selectpicker" required name="modalidad" id="select-modalidad">
                <option selected disabled value="">Selecciona una opción</option>
                <option value="individual">Delegación (individual)</option>
                <option value="pareja" id="select-modalidad-pareja">Codelegación (bina)</option>
            </select>
            <div class="invalid-feedback">Debes seleccionar una opción.</div>
        </div>

        <p id="codelegacion-nota" style="display: none;">
            <strong>Nota:</strong> El registro de una codelegación solo deberá llenarse una vez con la información de las dos participantes.
        </p>
    </div>

    <!-- Selección de delegación oficial -->
    <article class="titulo">
        <div class="oval">
            <h2>
                Delegación oficial
            </h2>
        </div>
    </article>

    <div class="mb-3">
        <p>Una delegación oficial es un grupo que representa a una agrupación y tiene a una persona que lo asesora.</p>

        <div>
            <label for="delegacion_oficial" class="form-label">¿Perteneces a una delegación oficial? <span style="color: red;">*</span></label>
            <select autocomplete="off" data-width="86vw" class="selectpicker" required name="delegacion_oficial" id="select-delegacion-oficial">
                <option selected disabled value="">Selecciona una opción</option>
                <option value="si">Sí</option>
                <option value="no">No</option>
            </select>
            <div class="invalid-feedback">Debes seleccionar una opción.</div>
        </div>

        <p id="delegacion-oficial-nota" style="display: none;">
            <strong>Nota:</strong> Para inscribirte como parte de una Delegación Oficial, primero se debe <a href="/registro-faculty">registrar el Faculty Advisor</a> y pagar la cuota de recuperación. Una vez confirmado el pago, ya se podrán registrar las personas integrantes de la Delegación Oficial.
        </p>

        <div style="margin-top: 1.5vh;">
            <input class="form-control" required autocomplete="off" name="nombre_delegacion_oficial" placeholder="Nombre completo de la agrupación (sin siglas o abreviaturas)" type="text" id="input-nombre-delegacion-oficial" maxlength="150">
            <div class="invalid-feedback">Debes llenar este campo.</div>
        </div>

        <div>
            <input class="form-control" required autocomplete="off" name="responsable_delegacion_oficial" placeholder="Nombre completo de la persona responsable de la delegación oficial" type="text" id="input-responsable-delegacion-oficial" maxlength="150">
            <div class="invalid-feedback">Debes llenar este campo.</div>
        </div>
    </div>

    <!-- Sección de datos personales de la delegación y codelegación -->
    {% for i in range(2) %}
        <article class="titulo" id="titulo-datos-{{ i }}">
            <div class="oval">
                <h2 id="titulo-datos-inner-{{ i }}">
