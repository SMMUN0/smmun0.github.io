<!-- Validación de teléfono -->
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@24.7.0/build/js/intlTelInput.min.js"></script>
<script type="module" defer>
    import es from "https://cdn.jsdelivr.net/npm/intl-tel-input@24.7.0/build/js/i18n/es/index.js";

    let celularInputs = document.getElementsByClassName("input-celular");
    for (let i = 0; i < celularInputs.length; i++) {
        let celInput = celularInputs.item(i);
        let intl = window.intlTelInput(celInput, {
            loadUtilsOnInit: "https://cdn.jsdelivr.net/npm/intl-tel-input@24.7.0/build/js/utils.js",
            i18n: es,
            initialCountry: "mx",
            hiddenInput: function() {
                return {
                    phone: celInput.dataset.name
                };
            }
        });

        celInput.addEventListener("input", function(e) {
            if (intl.isValidNumber()) {
                this.setCustomValidity("");
                this.classList.remove("is-invalid");
            }
            else if (this.value) {
                this.setCustomValidity("El número de celular no es válido.");
                this.classList.add("is-invalid");
            }
        });

        celInput.dispatchEvent(new Event("input", { bubbles: true }));
    }

    $(".iti__search-input").addClass("form-control");
    $("<div class='invalid-feedback'>El número de celular no es válido.</div>").insertAfter($(".iti__tel-input"));
</script>
