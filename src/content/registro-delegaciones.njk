<!-- Título -->
<article id="titulo-registro">
    <h1>
        <span>Registro de delegaciones<br></span>
    </h1>
</article>

<!-- Forms -->
<form method="POST" action="http://localhost:8000/registro-delegaciones" name="registro-delegaciones" id="registro-delegaciones" enctype="multipart/form-data" class="col g-3" novalidate>
    <!-- Selección de modalidad -->
    <div class="mb-3">
        <h2>Modalidad</h2>

        <div>
            <label for="modalidad" class="form-label">Selecciona tu modalidad de participación <span style="color: red;">*</span></label>
            <select data-width="86vw" class="selectpicker" required name="modalidad" id="select-modalidad">
                <option selected disabled value="">Selecciona una opción</option>
                <option value="individual">Delegación (individual)</option>
                <option value="pareja" id="select-modalidad-pareja">Codelegación (pareja)</option>
            </select>
            <div class="invalid-feedback">Debes seleccionar una opción.</div>
        </div>
    </div>

    <hr>

    <!-- Selección de delegación oficial -->
    <div class="mb-3">
        <h2>Delegación oficial</h2>
        <p>Una delegación oficial es un grupo que representa a una institución y tiene a una persona que lo asesora.</p>

        <div>
            <label for="delegacion_oficial" class="form-label">¿Perteneces a una delegación oficial? <span style="color: red;">*</span></label>
            <select data-width="86vw" class="selectpicker" required name="delegacion_oficial" id="select-delegacion-oficial">
                <option selected disabled value="">Selecciona una opción</option>
                <option value="si">Sí</option>
                <option value="no">No</option>
            </select>
            <div class="invalid-feedback">Debes seleccionar una opción.</div>
        </div>

        <div>
            <input class="form-control" required autocomplete="off" name="nombre_delegacion_oficial" placeholder="Nombre de la institución" type="text" id="input-nombre-delegacion-oficial" maxlength="100">
            <div class="invalid-feedback">Debes llenar este campo.</div>
        </div>
    </div>

    <hr>

    <!-- Sección de datos personales de la delegación y codelegación -->
    {% for i in range(2) %}
        <div id="datos_personales_{{ i }}" class="mb-3">
            {% if i == 0 %}
                <h2>Datos personales</h2>
            {% else %}
                <h2>Datos personales de la codelegación</h2>
            {% endif %}

            <label for="nombre_{{ i }}" class="form-label">Nombre completo <span style="color: red;">*</span></label>
            <div class="row g-3">
                <div class="col">
                    <input class="form-control" required autocomplete="off" name="nombre_{{ i }}" placeholder="Nombre(s)" type="text" maxlength="100">
                    <div class="invalid-feedback">Debes llenar este campo.</div>
                </div>
                <div class="col">
                    <input class="form-control" required autocomplete="off" name="apellido_{{ i }}" placeholder="Apellidos" type="text" maxlength="100">
                    <div class="invalid-feedback">Debes llenar este campo.</div>
                </div>
            </div>

            <div>
                <label for="edad_{{ i }}" class="form-label">Edad <span style="color: red;">*</span></label>
                <input class="form-control input-edad" required autocomplete="off" name="edad_{{ i }}" placeholder="12-26 años" type="text" maxlength="2" inputmode="numeric">
                <div class="invalid-feedback">La edad no es válida.</div>
            </div>

            <div>
                <label for="celular_{{ i }}" class="form-label">Número de celular <span style="color: red;">*</span></label>
                <input class="form-control input-celular" required autocomplete="off" name="celular_{{ i }}" placeholder="999 123 4567" type="tel" maxlength="30">
                <div class="invalid-feedback">Debes llenar este campo.</div>
            </div>

            <div>
                <label for="correo_{{ i }}" class="form-label">Correo electrónico <span style="color: red;">*</span></label>
                <input class="form-control input-correo" required autocomplete="off" name="correo_{{ i }}" placeholder="ejemplo@dominio.com" type="email" maxlength="100">
                <div class="invalid-feedback">El correo no es válido.</div>
            </div>

