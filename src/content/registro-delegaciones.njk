                    {% endif %}

                    <select data-width="86vw" class="selectpicker select-comite-{{ i }}-pais" required name="comite_{{ i }}_pais_{{ j }}" id="select-comite-{{ i }}-pais-{{ j }}" data-live-search="true">
                        <option selected disabled value="">Selecciona una opción</option>
                        <!-- CSTD -->
                        <option data-tokens="arabia saudita" class="CSTD" value="CSTD:Reino de Arabia Saudita">🇸🇦&emsp;Reino de Arabia Saudita</option>
                        <option data-tokens="argelia" class="CSTD" value="CSTD:República Argelina Democrática y Popular">🇩🇿&emsp;República Argelina Democrática y Popular</option>
                        <option data-tokens="austria" class="CSTD" value="CSTD:República de Austria">🇦🇹&emsp;República de Austria</option>
                        <option data-tokens="bielorrusia" class="CSTD" value="CSTD:República de Belarús">🇧🇾&emsp;República de Belarús</option>
                        <option data-tokens="botsuana" class="CSTD" value="CSTD:República de Botsuana">🇧🇼&emsp;República de Botsuana</option>
                        <option data-tokens="brasil" class="CSTD" value="CSTD:República Federativa del Brasil">🇧🇷&emsp;República Federativa del Brasil</option>
                        <option data-tokens="camerun" class="CSTD" value="CSTD:República de Camerún">🇨🇲&emsp;República de Camerún</option>
